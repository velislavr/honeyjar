# Public entrypoint. DOMAIN comes from core/.env (e.g. honeyjar.tech); Caddy gets TLS automatically.
{$DOMAIN:localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	# Sensor ingest is only reachable over WireGuard, never through the public proxy.
	# (A bare `respond` would run after `handle`, so it has to be its own, more specific handle block.)
	handle /api/ingest* {
		respond 404
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy dashboard:3000
	}
}
