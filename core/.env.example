POSTGRES_PASSWORD=change-me
# Sensor registry: id -> token + map location of the sensor (for attack arcs).
SENSORS={"local-1": {"token": "dev-sensor-token-change-me", "label": "Local dev", "lat": 42.70, "lon": 23.32}}
CORS_ORIGINS=http://localhost:3000
# Optional threat intel (free tiers)
ABUSEIPDB_KEY=
MALWAREBAZAAR_KEY=
# Session triage: rules-only verdicts unless Jev is enabled (on by default when JEV_API_KEY is set)
# TRIAGE_ENABLED=1
JEV_API_KEY=
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-1.13.0
# JEV_DAILY_TOKEN_BUDGET=2000000
# Free, keyless (undocumented, best effort - dev/testing): OpenCode's proxy, about one call a minute
# JEV_ENABLED=1
# JEV_API_URL=https://opencode.ai/inference/systemone/v1/systemone
# JEV_MODEL=jev-1.13-free
# JEV_MIN_INTERVAL=60
# Production: bind the API to the WireGuard IP so sensors can reach /api/ingest
# API_BIND=10.66.0.1:8000
# TRUST_PROXY=1
# Public hostname for Caddy (prod profile): docker compose --profile prod up -d
# DOMAIN=honeyjar.tech
# CORS_ORIGINS=https://honeyjar.tech
